# --- Hiper (API personalizada) ---
# Produção: https://ms-ecommerce.hiper.com.br  |  Mock local (H1): http://localhost:8000
HIPER_URL=https://ms-ecommerce.hiper.com.br
# Hiper Gestão → Vendas → Loja virtual → chave de segurança (64 caracteres)
HIPER_CHAVE_DE_SEGURANCA=

# --- WooCommerce ---
# WooCommerce → Configurações → Avançado → REST API → Adicionar chave (permissão Leitura/Escrita)
WOO_URL=https://sualoja.com.br
WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx

# --- Pedido de venda ---
# Obrigatório para lojas de SC (Marketplace.Cnpj e Marketplace.Nome)
MARKETPLACE_CNPJ=
MARKETPLACE_NOME=Loja Virtual
# gateway do WooCommerce → idMeioDePagamento do Hiper (1 dinheiro, 4 crédito, 5 débito, 6 crediário, 11 voucher, 12 pix)
# MAPA_PAGAMENTO={"pagbank_pix": 12, "pagbank_credit_card": 4}
MEIO_PAGAMENTO_PADRAO=4
# Ignora pedidos anteriores a esta data na primeira execução
PEDIDOS_A_PARTIR_DE=

# --- Operação ---
CONECTOR_INTERVALO=60
CONECTOR_BANCO=conector.db
ESTOQUE_SEGURANCA=0
CONCLUIR_AO_FATURAR=1
USAR_VIACEP=1
PORTA_PAINEL=8200
